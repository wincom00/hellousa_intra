# ============================================================
# 상품 이미지 업로드 폴더 스크립트 실행 차단 (웹쉘 방지)
# 이 디렉토리에는 이미지 파일만 존재해야 하며,
# PHP 등 어떤 서버 스크립트도 실행되어서는 안 된다.
#
# ※ FileInfo 클래스 지시어(SetHandler/ForceType)만 사용 → AllowOverride 500 위험 최소.
#    mod_php(AddHandler·SetHandler)와 PHP-FPM(proxy handler) 양쪽 모두 실행 차단.
# ※ Apache 전용. Nginx 환경은 server 블록에서 별도 차단 필요.
# ============================================================

# 스크립트성 파일: 핸들러 제거 + 평문(text/plain)으로 강제 → 실행되지 않음
<FilesMatch "(?i)\.(php|phps|phtml|php[0-9]|phar|pht|cgi|pl|py|sh|asp|aspx|jsp)$">
    SetHandler none
    ForceType text/plain
</FilesMatch>
